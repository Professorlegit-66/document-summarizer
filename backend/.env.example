APP_NAME="Document Summarizer API"
DEBUG=True
FRONTEND_ORIGIN=http://localhost:5173

# AI provider: "ollama" (local dev default) or "groq" (production)
AI_PROVIDER=ollama

# AI / Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=600.0

# AI / Groq configuration — only required when AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30.0
GROQ_CHUNK_PACING_SECONDS=2.0

# Upload / document limits
MAX_UPLOAD_SIZE_MB=10.0
MAX_EXTRACTED_CHARS=200000